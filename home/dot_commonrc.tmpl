#
# Common settings for both bash and zsh
# File is sourced in .bashrc and .zshrc
#

export GIT_CONFIG_GLOBAL="$XDG_CONFIG_HOME/git/config"

export USER_EMAIL={{ .email }}
export GITHUB_USER={{ .githubUser }}

ulimit -S -n 131070

umask 027

{{- if .headless }}
export EDITOR=emacs
{{- else }}
export EDITOR=codium
{{- end }}

# Topical alias/function files managed by chezmoi
if [ -d "$HOME/.config/shell" ]; then
  for f in "$HOME"/.config/shell/*.sh; do
    [ -r "$f" ] && source "$f"
  done
fi

# machine-local, unmanaged
if [ -f $HOME/.private_alias ]; then
  source $HOME/.private_alias
fi

if [ -n "$ZSH_VERSION" ]; then
    current_shell=zsh
elif [ -n "$BASH_VERSION" ]; then
    current_shell=bash
else
    echo "Unknown shell: direnv hook not loaded"
    exit 1
fi

# Activate mise before the shell-integration hooks below, so tools it manages
# (e.g. starship) are on PATH when their init runs.
if command -v mise > /dev/null 2>&1; then
  eval "$(mise activate $current_shell)";
fi

# Re-prepend ~/.npm-global/bin so npm globals beat stale copies under mise node dirs (see .profile).
if [ -d "$HOME/.npm-global/bin" ]; then
  export PATH="$HOME/.npm-global/bin:$PATH"
fi

# Scoped agent identity wrappers (`lara claude ...`); see ~/bin/agents/SETUP.md.
if [ -d "$HOME/bin/agents" ]; then
  export PATH="$HOME/bin/agents:$PATH"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init $current_shell)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init $current_shell)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook $current_shell)"
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init $current_shell)"
fi

if command -v wt > /dev/null 2>&1; then
  eval "$(wt config shell init $current_shell)";
fi

# Auto-activate .venv on directory change (no .envrc needed)
_auto_venv() {
  if [[ -d .venv ]] && [[ -f .venv/bin/activate ]]; then
    source .venv/bin/activate
  elif [[ -n "$VIRTUAL_ENV" ]] && [[ ! -d .venv ]]; then
    deactivate 2>/dev/null
  fi
}

if [[ -n "$ZSH_VERSION" ]]; then
  autoload -U add-zsh-hook
  add-zsh-hook chpwd _auto_venv
elif [[ -n "$BASH_VERSION" ]]; then
  PROMPT_COMMAND="_auto_venv${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
_auto_venv

if command -v try &> /dev/null; then
  eval "$(try init ~/tries)"
fi

# prek emits a clap dynamic completer that shells out to the binary per keypress,
# so it cannot live as a static _prek in fpath like the other completions.
if command -v prek > /dev/null 2>&1; then
  eval "$(COMPLETE=$current_shell prek)"
fi

export CURRENT_SHELL=$current_shell

{{ $argComplete := "register-python-argcomplete3" }}
{{- if lookPath "register-python-argcomplete" }}
{{ $argComplete = "register-python-argcomplete" }}
{{- end }}

# Disable the AWS_PAGER to prevent the aws cli from paging output: OMG annoying
# https://docs.aws.amazon.com/cli/latest/userguide/cli-usage-pagination.html
export AWS_PAGER=""

# BUN_CONFIG_DISABLE_COPY_FILE_RANGE as bun seems to have problems with encryptfs
# https://github.com/anthropics/claude-code/issues/8158
export BUN_CONFIG_DISABLE_COPY_FILE_RANGE=true

#!/usr/bin/env bash

# Install uv and the Python interpreters. The Python CLI tools that used to be
# installed here now live in mise's pipx backend (private_dot_config/mise);
# this script only provides the runtime they are built against.
#
# uv itself stays out of mise on purpose: this is a run_onchange_before_ script,
# so it runs before mise has installed anything, and mise's pipx backend needs uv
# to already exist. Pinned in .chezmoidata.yaml and fetched from a tagged release
# instead of the rolling astral.sh installer, so a new machine gets a known version.
#
# Pin UV_INSTALL_DIR so the installer uses a normalized path: with XDG_DATA_HOME
# set but XDG_BIN_HOME unset, uv would otherwise derive $XDG_DATA_HOME/../bin and
# its literal string shadow-check would falsely flag uv/uvx as shadowed in PATH.
curl --proto '=https' --tlsv1.2 -LsSf \
  https://github.com/astral-sh/uv/releases/download/{{ .installers.uv.version }}/uv-installer.sh \
  | env INSTALLER_NO_MODIFY_PATH=1 UV_INSTALL_DIR="$HOME/.local/bin" sh

DEFAULT_PYTHON_VERSION={{- .langs.python }} # Set the default Python version

$HOME/.local/bin/uv python install 3.13
$HOME/.local/bin/uv python install 3.14
$HOME/.local/bin/uv python install 3.15 # pre-release; resolves to latest 3.15 beta until stable ships

$HOME/.local/bin/uv python install "$DEFAULT_PYTHON_VERSION" --default --preview

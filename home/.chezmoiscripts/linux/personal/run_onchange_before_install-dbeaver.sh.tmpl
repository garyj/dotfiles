#!/usr/bin/env bash

# DBeaver Community via vendor apt repo.
# Reference: https://github.com/dbeaver/dbeaver/wiki/Installation

set -euo pipefail

{{ template "add-apt-repo" . }}

add_apt_repo dbeaver \
  https://dbeaver.io/debs/dbeaver.gpg.key \
  "deb [signed-by=/usr/share/keyrings/dbeaver.gpg] https://dbeaver.io/debs/dbeaver-ce /"

sudo apt-get update
sudo apt-get install -y dbeaver-ce

{{- if not .ephemeral -}}

#!/usr/bin/env bash
set -euo pipefail

# Materializes Lara's 1Password service-account token to a 0600 file that
# ~/bin/agents/lara points AGENT_STATE_DIR at, and identity.sh reads from there.

TOKEN_DIR="{{ .chezmoi.homeDir }}/.config/gj_agents/lara"
TOKEN_PATH="$TOKEN_DIR/token"

mkdir -p "$TOKEN_DIR"
chmod 700 "$TOKEN_DIR"

# onepasswordRead content hash: {{ onepasswordRead "op://Personal/Service Account - 1Password/lara" | sha256sum }}
printf '%s' '{{ onepasswordRead "op://Personal/Service Account - 1Password/lara" | trim }}' > "$TOKEN_PATH"
chmod 600 "$TOKEN_PATH"

{{ end -}}

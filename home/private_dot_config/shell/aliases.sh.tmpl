# General aliases and small helpers, sourced by ~/.commonrc for bash and zsh.

alias g=git
# Open the current repo path on GitHub for the branch you're actually on
# (works from any worktree). If that branch isn't on the remote yet, fall back
# to the default branch so you land on a real page instead of a 404.
_gh_browse_here() {
  local branch remote
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
    gh browse . >/dev/null 2>&1 &   # detached / not a repo: use repo default
    return
  fi
  remote=$(git config "branch.$branch.remote" 2>/dev/null)
  [ -n "$remote" ] || remote=origin
  if git rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null; then
    gh browse . -b "$branch" >/dev/null 2>&1 &
  else
    echo "ghb: '$branch' isn't on $remote yet, opening the default branch instead" >&2
    gh browse . >/dev/null 2>&1 &
  fi
}
alias ghb=_gh_browse_here
ghbe() {
  _gh_browse_here
  disown
  exit
}

# Open the PR for the branch you're on, draft or open (works from any worktree).
# PR existence is server-side, so this always does a network lookup. If there's
# no PR for the branch, say so and open nothing.
_gh_pr_here() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if gh pr view --web >/dev/null 2>&1; then
    return 0
  fi
  echo "ghbpr: no PR for '${branch:-this branch}'" >&2
  return 1
}
alias ghbpr=_gh_pr_here
ghbpre() {
  # Exit only if a PR actually opened; on "no PR" stay so the message is visible.
  _gh_pr_here && exit
}

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
  alias ccp="pwd | wl-copy"
  ccf() {
    if [ -z "$1" ]; then echo "Usage: ccf <filename>"; return 1; fi
    realpath -- "$1" | wl-copy
  }
else
  alias ccp="pwd | xclip -selection clipboard"
  ccf() {
    if [ -z "$1" ]; then echo "Usage: ccf <filename>"; return 1; fi
    realpath -- "$1" | xclip -selection clipboard
  }
fi

# Count open X11 connections vs the server cap (default 256).
# Handy when GUI apps refuse to launch with "Maximum number of clients reached".
xconns() {
  local disp="${DISPLAY#:}"
  disp="${disp%%.*}"
  local count cap
  count=$(ss -x | grep -c "@/tmp/.X11-unix/X${disp:-0}")
  cap=$(ps -o cmd= -C Xorg | grep -oP 'maxclients \K[0-9]+' || echo 256)
  echo "X11 connections: ${count} / ${cap}"
}


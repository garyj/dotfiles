#!/usr/bin/env bash
#
# git prepare-commit-msg hook: appends the issue key from the current branch
# name (e.g. fix/PROJ-456-broken-link -> "... PROJ-456") to the first line of
# the commit message.
# based on: https://bitbucket.org/atlassian/workspace/snippets/qedp7d

# merge commits and amends keep their existing message
if [ "$2" = "merge" ] || [ "$2" = "commit" ]; then
    exit
fi

ISSUE_KEY=$(git branch --show-current | grep -o "[A-Z0-9]\{2,\}-[0-9]\+")
if [ $? -ne 0 ]; then
    # no issue key in branch, use the default message
    exit
fi

# skip if the message already carries the key, so it is never added twice
if grep -q "$ISSUE_KEY" "$1"; then exit 0; fi

sed -i -e "1s/$/ $ISSUE_KEY/" "$1"

{
  "cli_default_open_behavior": "new_window",
  "window_title_format": "${projectName}  ⎇ ${branch}${separator}${fileName}",
  "window_title_separator": " - ",
  "diff_view_style": "split",
  "minimum_split_diff_width": 0,
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "github-dark-default": true,
    "html": true,
    "ini": true,
    "just": true,
    "make": true,
    "markdown-oxide": true,
    "powershell": true,
    "rainbow-csv": true,
    "toml": true,
    "vscode-icons": true,
    "xml": true
  },
  "theme": "GitHub Dark Default",
  "selection_highlight": true,
  "theme_overrides": {
    "GitHub Dark Default": {
      "players": [
        {
          "selection": "#044B5C"
        }
      ],
      "editor.document_highlight.read_background": "#17E5E626",
      "editor.document_highlight.write_background": "#17E5E640"
    }
  },
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "ui_font_size": 20,
  "buffer_font_size": 18,
  "languages": {
    "Just": {
      "tab_size": 4,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "scan_symlinks": "always",
  "file_scan_inclusions": [
    ".env*",
    "tmp/**"
  ],
  "hidden_files": [
    "**/__pycache__",
    "**/.~*",
    "**/.cache",
    "**/.classpath",
    "**/.coverage",
    "**/.factorypath",
    "**/.ipynb_checkpoints",
    "**/.ipython",
    "**/.mypy_cache",
    "**/.project",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.scrapy",
    "**/.settings",
    "**/.site",
    "**/.svelte-kit",
    "**/.tox",
    "**/.venv",
    "**/.worktrees",
    "**/*.egg-info",
    "**/*.pyc",
    "**/apm_modules",
    "**/aws/build",
    "**/build",
    "**/cdk.out",
    "**/coverage.xml",
    "**/coverage",
    "**/htmlcov",
    "**/node_modules",
    "**/playwright-report",
    "**/static/build",
    "aws/build",
    "site",
    "static/_app"
  ],
  "preview_tabs": {
    "enabled": false
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "entry_primary_click_action": "file_diff"
  },
  "git": {
    "file_diff": {
      "show_full_file": true
    }
  },
  "auto_update": false
}

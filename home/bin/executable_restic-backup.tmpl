#!/usr/bin/env bash
#
# restic-backup - thin wrapper around restic for the backup repos.
# Managed by chezmoi; edit the template, not ~/bin/restic-backup.
# What/where to back up is configured in home/.chezmoidata/backup.yaml.
#
# Scheduled use (systemd timer, hourly):
#   restic-backup                # back up locally, forget old snapshots, copy the
#                                # new snapshots offsite, then ping healthchecks
#
# Manual use - any restic command is passed straight through, already pointed
# at the local repo with the password loaded:
#   restic-backup snapshots
#   restic-backup mount /tmp/restore
#   restic-backup restore latest --target /tmp/restore --include ~/some/file
#   restic-backup check          # verify repo integrity
#   restic-backup prune          # reclaim space (heavier; run occasionally)
#
# Offsite remote (Wasabi):
#   restic-backup copy           # push new snapshots offsite (one-time seed / manual)
#   restic-backup remote snapshots   # any restic command against the remote repo,
#   restic-backup remote prune       # with its S3 credentials loaded automatically

set -euo pipefail

# restic is a pinned binary in /usr/local/bin; ensure it's found even under
# systemd's minimal PATH.
export PATH="/usr/local/bin:$PATH"

export RESTIC_REPOSITORY="{{ .backup.local_repo }}"
export RESTIC_PASSWORD_FILE="{{ .chezmoi.homeDir }}/.config/restic/password"
config_dir="{{ .chezmoi.homeDir }}/.config/restic"

# The offsite remote repo (Wasabi S3): one restic repo per host, under
# <bucket>/<hostname>, so a single bucket holds every machine. Empty when no
# remote bucket is configured, which disables the copy step entirely.
{{ if .backup.remote.bucket -}}
remote_repo="s3:{{ .backup.remote.endpoint }}/{{ .backup.remote.bucket }}/{{ .chezmoi.hostname }}"
{{ else -}}
remote_repo=""
{{ end -}}

# Run restic gently so an hourly backup never fights interactive work.
restic_gentle() { nice -n 19 ionice -c 3 restic "$@"; }

# Refuse to touch the repo if its disk isn't mounted - we'd otherwise read or
# write the root filesystem, the very disk /extra exists to outlive. The offsite
# copy reads the local repo too, so it needs this guard as well.
require_repo_mounted() {
{{ if .backup.require_mounted -}}
  if ! mountpoint -q "{{ .backup.require_mounted }}"; then
    echo "restic-backup: {{ .backup.require_mounted }} not mounted; refusing to run." >&2
    exit 1
  fi
{{ else -}}
  : # no mount requirement on this host (e.g. a single-disk laptop)
{{ end -}}
}

# Thin out old snapshots per the retention policy (no --prune here; that's
# heavier, run occasionally via `j backup::prune`). Leading args are passed to
# restic as global flags, so `run_forget -r "$remote_repo"` thins the remote too.
# --group-by host: restic's default also groups by paths, so editing sources in
# backup.yaml strands the old path-set's snapshots forever.
run_forget() {
  restic_gentle "$@" forget \
    --group-by host \
    --tag automated \
    --keep-hourly {{ .backup.retention.keep_hourly }} \
    --keep-daily {{ .backup.retention.keep_daily }} \
    --keep-weekly {{ .backup.retention.keep_weekly }} \
    --keep-monthly {{ .backup.retention.keep_monthly }} \
    --keep-yearly {{ .backup.retention.keep_yearly }}
}

# restic skips a missing source with exit 0, so a typo in backup.yaml silently
# shrinks the backup. Warn (don't fail - one bad path shouldn't cost the run)
# and record the count, so the end-of-run ping can escalate it to an alert.
missing_sources=0
check_sources() {
  local path total=0
  missing_sources=0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    total=$((total + 1))
    if [ ! -e "$path" ]; then
      echo "restic-backup: WARNING - configured source does not exist: $path" >&2
      missing_sources=$((missing_sources + 1))
    fi
  done < "$config_dir/sources.txt"

  if [ "$missing_sources" -gt 0 ]; then
    echo "restic-backup: WARNING - $missing_sources of $total sources missing; backing up the rest." >&2
    echo "restic-backup: fix them in home/.chezmoidata/backup.yaml, then: chezmoi apply" >&2
  fi
}

do_backup() {
  local rc=0
  check_sources
  restic_gentle backup \
    --files-from "$config_dir/sources.txt" \
    --exclude-file "$config_dir/excludes.txt" \
    --exclude-caches \
    --tag automated "$@" || rc=$?

  # restic exits 3 when some files couldn't be read (e.g. a file vanished
  # mid-run). The rest was still backed up, so keep going - but say so, so a
  # persistently unreadable source isn't completely silent.
  if [ "$rc" -eq 3 ]; then
    echo "restic-backup: warning - some files were unreadable (exit 3); backed up the rest." >&2
  elif [ "$rc" -ne 0 ]; then
    return "$rc"
  fi

  # forget is housekeeping - warn, don't fail. A lock from a killed run blocks
  # every future forget until cleared, so retry once after unlock (which only
  # removes locks whose process is dead, never a live run's).
  if ! run_forget; then
    echo "restic-backup: retention failed; clearing stale locks and retrying." >&2
    restic_gentle unlock || true
    run_forget \
      || echo "restic-backup: warning - retention (forget) failed; the snapshot was still captured." >&2
  fi
}

# Push new snapshots to the offsite remote (Wasabi), then mirror the local
# retention there. Best-effort: the local backup is the critical path and is
# already done by the time we get here, so a remote hiccup must NOT fail the run;
# it's surfaced via the healthchecks ping instead. Returns non-zero only when a
# configured, credentialled remote genuinely fails to receive the copy.
do_copy() {
  [ -n "$remote_repo" ] || return 0
  if [ ! -s "$config_dir/remote-env" ]; then
    echo "restic-backup: remote-env absent; skipping offsite copy (add Wasabi creds to 1Password, then chezmoi apply)." >&2
    return 0
  fi
  set -a
  # shellcheck disable=SC1091
  . "$config_dir/remote-env"
  set +a

  local rc=0
  restic_gentle {{ if .backup.remote.limit_upload }}--limit-upload {{ .backup.remote.limit_upload }} {{ end }}-r "$remote_repo" copy \
    --from-repo "$RESTIC_REPOSITORY" \
    --from-password-file "$RESTIC_PASSWORD_FILE" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "restic-backup: offsite copy to the remote failed (rc=$rc)." >&2
    return "$rc"
  fi

  # Mirror local retention on the remote (forget only; prune stays manual). Same
  # stale-lock retry as local. A forget failure warns but doesn't fail the copy -
  # the snapshots are already offsite, which is what matters.
  if ! run_forget -r "$remote_repo"; then
    echo "restic-backup: remote retention failed; clearing stale locks and retrying." >&2
    restic_gentle -r "$remote_repo" unlock || true
    run_forget -r "$remote_repo" \
      || echo "restic-backup: warning - remote retention (forget) failed; snapshots were still copied." >&2
  fi
}

if [ "${1:-}" = "copy" ]; then
  require_repo_mounted
  exec 9>"$config_dir/.lock"
  if ! flock -n 9; then
    echo "restic-backup: a run is already in progress; skipping copy." >&2
    exit 0
  fi
  do_copy
  exit $?
fi

if [ "${1:-}" = "remote" ]; then
  shift
  [ -n "$remote_repo" ] || { echo "restic-backup: no remote configured (set backup.remote.bucket)." >&2; exit 1; }
  [ -s "$config_dir/remote-env" ] || { echo "restic-backup: remote-env absent; add Wasabi creds to 1Password, then chezmoi apply." >&2; exit 1; }
  set -a
  # shellcheck disable=SC1091
  . "$config_dir/remote-env"
  set +a
  exec restic -r "$remote_repo" "$@"
fi

if [ "$#" -gt 0 ] && [ "$1" != "backup" ]; then
  exec restic "$@"
fi
# Strip an optional leading `backup` so extra args (e.g. --dry-run) reach restic.
if [ "${1:-}" = "backup" ]; then shift; fi

require_repo_mounted

# The configured backup. Serialise so two runs never overlap; if one is already
# going, skip quietly (exit 0) so the timer stays green.
exec 9>"$config_dir/.lock"
if ! flock -n 9; then
  echo "restic-backup: a run is already in progress; skipping." >&2
  exit 0
fi

rc=0
do_backup "$@" || rc=$?

# Push the new snapshots offsite in the same run (same lock).
copy_failed=0
do_copy || copy_failed=$?

# Report to healthchecks.io. A clean run pings success; a failed run, a failed
# offsite copy, retention not thinning, a lock left by a dead run, or a missing
# source pings .../fail with the reason. No ping at all trips the dead-man's-
# switch, which is how a dead timer or an off machine gets caught. The URL is a
# 1Password secret; until it's set up the backup still runs, we just skip the ping.
problems=()
[ "$rc" -ne 0 ] && problems+=("backup exited $rc")
[ "$copy_failed" -ne 0 ] && problems+=("offsite copy to the remote failed")
[ "$missing_sources" -gt 0 ] && problems+=("$missing_sources source(s) missing")

count=$(restic_gentle --no-lock snapshots --json 2>/dev/null \
  | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null)
if [ -n "$count" ] && [ "$count" -gt {{ .backup.monitoring.max_snapshots }} ]; then
  problems+=("snapshot count $count over {{ .backup.monitoring.max_snapshots }} (retention stalled?)")
fi

if [ -d "{{ .backup.local_repo }}/locks" ]; then
  stale=$(find "{{ .backup.local_repo }}/locks" -type f -mmin +{{ .backup.monitoring.max_lock_age_minutes }} 2>/dev/null | wc -l)
  [ "$stale" -gt 0 ] && problems+=("$stale lock(s) older than {{ .backup.monitoring.max_lock_age_minutes }}m")
fi

hc_url=""
[ -s "$config_dir/healthchecks-url" ] && hc_url=$(tr -d '[:space:]' < "$config_dir/healthchecks-url")
if [ -n "$hc_url" ]; then
  if [ "${#problems[@]}" -eq 0 ]; then
    printf 'ok\n' | curl -fsS -m 15 --retry 3 --data-binary @- "$hc_url" >/dev/null 2>&1 \
      || echo "restic-backup: warning - healthchecks ping failed" >&2
  else
    printf '%s\n' "${problems[@]}" | curl -fsS -m 15 --retry 3 --data-binary @- "$hc_url/fail" >/dev/null 2>&1 \
      || echo "restic-backup: warning - healthchecks fail-ping failed" >&2
  fi
fi

# Exit non-zero if anything's wrong, so `systemctl status` agrees with the ping.
# Keep the backup's own code if it failed; else 1 for a broken invariant.
if [ "${#problems[@]}" -ne 0 ] && [ "$rc" -eq 0 ]; then
  rc=1
fi
exit "$rc"

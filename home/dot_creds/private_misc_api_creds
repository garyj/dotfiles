#!/usr/bin/env bash
# Each field in the item's "env" section becomes one variable: label is the name,
# value is the secret. Move a field to the "disabled" section to stop exporting it.
eval "$(
  op item get "Misc Credentials" --vault "Personal" --reveal --format=json \
  | jq -r '.fields[]
           | select(.section.label == "env")
           | select(.value != null and .value != "")
           | select(.label | test("^[A-Za-z_][A-Za-z0-9_]*$"))
           | "export \(.label)=\(.value | @sh)"'
)"

{{ if .personal -}}
[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/refs/tags/{{ .externals.zsh_syntax_highlighting }}.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/refs/tags/v{{ .externals.zsh_autosuggestions }}.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".local/share/fonts/Monaspace"]
    type = "archive"
    url = "https://github.com/githubnext/monaspace/archive/master.zip"
    exact = true
    stripComponents = 4
    refreshPeriod = "168h"
    include = ["**/*.otf", "**/*.ttf"]

# Cloned, not rendered, so an edit in ~/.agents is live without an apply.
[".agents"]
    type = "git-repo"
    url = "https://github.com/garyj/dotagents.git"
    refreshPeriod = "24h"
    pull.args = ["--ff-only"]

# Skills that ship with a pinned CLI. ~/.agents/scripts/install links each into ~/.agents/skills.
[".local/share/agent-skills/agent-browser"]
    type = "archive"
    url = "https://github.com/vercel-labs/agent-browser/archive/refs/tags/v{{ .tools.agent_browser }}.tar.gz"
    stripComponents = 3
    refreshPeriod = "24h"
    include = ["*/skills/agent-browser/**"]

# Own repo with no releases: main is the only version there is to track.
[".local/share/agent-skills/deps-upgrade-report"]
    type = "archive"
    url = "https://github.com/garyj/deps-upgrade-report/archive/refs/heads/main.tar.gz"
    exact = true
    stripComponents = 3
    refreshPeriod = "24h"
    include = ["*/skills/deps-upgrade-report/**"]
    # Running the tests here writes __pycache__, which exact then prompts to delete.
    exclude = ["*/skills/deps-upgrade-report/tests/**"]

[".local/share/agent-skills/sentry-cli"]
    type = "archive"
    url = "https://github.com/getsentry/cli/archive/refs/tags/{{ .tools.sentry }}.tar.gz"
    stripComponents = 5
    refreshPeriod = "24h"
    include = ["*/plugins/sentry-cli/skills/sentry-cli/**"]

[".local/share/agent-skills/worktrunk"]
    type = "archive"
    url = "https://github.com/max-sixty/worktrunk/archive/refs/tags/v{{ .tools.worktrunk }}.tar.gz"
    stripComponents = 3
    refreshPeriod = "24h"
    include = ["*/skills/worktrunk/**"]

{{ end -}}

